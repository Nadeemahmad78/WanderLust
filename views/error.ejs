<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="alert alert-danger col-6 offset-3" role="alert">
    <h4 class="alert-heading"><%= (err && err.message) || 'Something went wrong' %></h4>
    <% if (err && err.stack && process.env.NODE_ENV !== 'production') { %>
      <pre class="mt-2"><%= err.stack %></pre>
    <% } %>
  </div>
</div>